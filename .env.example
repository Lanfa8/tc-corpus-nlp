TRIAGE_DATA_DIR=data
TRIAGE_MODELS_DIR=models
TRIAGE_BACKEND=sklearn
TRIAGE_LOG_LEVEL=INFO

# UID the Airflow containers run as (docker-compose.airflow.yml). Should be
# your host user's UID (`id -u`), not the image's built-in 50000 — the
# containers write into the host-mounted models/ directory, and running as
# your own UID keeps that directory writable from both the host (e.g.
# `make train`) and the containers with no ownership changes needed.
# `make airflow-up` sets this automatically on first run if it's missing.
AIRFLOW_UID=1000
