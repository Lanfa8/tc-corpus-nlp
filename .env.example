TRIAGE_DATA_DIR=data
TRIAGE_MODELS_DIR=models
TRIAGE_BACKEND=sklearn
TRIAGE_LOG_LEVEL=INFO

# UID the Airflow containers run as (docker-compose.airflow.yml).
# airflow-init chowns the bind-mounted airflow/logs and models directories to
# this UID at startup, so no manual host permission fix is needed. Default
# 50000 is the airflow image's built-in user; if you want those directories
# to stay owned by your own host user afterwards, run:
# echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000
